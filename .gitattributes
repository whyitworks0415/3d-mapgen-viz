# Default to LF line endings for text files, autodetect everything else.
* text=auto eol=lf

# Source files
*.cpp        text eol=lf
*.h          text eol=lf
*.hpp        text eol=lf
*.glsl       text eol=lf
*.vert       text eol=lf
*.frag       text eol=lf
*.comp       text eol=lf
*.txt        text eol=lf
*.md         text eol=lf
CMakeLists.txt text eol=lf

# Binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.spv        binary
*.exe        binary
*.dll        binary
*.lib        binary
*.pdb        binary
